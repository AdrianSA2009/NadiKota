APP_NAME=NadiKota
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL + PostGIS
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nadi_kota
DB_USERNAME=nadi_kota
DB_PASSWORD=change-me

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=nadi-kota-photos
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000
FRONTEND_URL=http://localhost:3000

# Clustering (FR-14)
CLUSTERING_RADIUS_METERS=20

# AI Validation (FR-08, FR-09, FR-11)
AI_TIMEOUT_SECONDS=20
AI_MAX_DAILY_CALLS=5000
AI_PROMPT_VERSION=v1.0
AI_ACCEPTED_MIN_CONFIDENCE=0.7
AI_REJECTED_MAX_CONFIDENCE=0.3

# SLA (FR-30)
SLA_BUSINESS_HOURS=8
SLA_ESCALATION_DAY1_ROLE=supervisor
SLA_ESCALATION_DAY3_ROLE=admin
SLA_ESCALATION_DAY5_ROLE=super_admin

# Rate Limiting (FR-12)
REPORTS_PER_USER_PER_DAY=10
REPORTS_PER_IP_PER_MINUTE=30

# Photo (NFR-7.1)
PHOTO_MAX_SIZE_BYTES=1048576

# OTP (FR-01)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# Geo bounding box Batam (FR-05)
GEO_MIN_LAT=0.9
GEO_MAX_LAT=1.3
GEO_MIN_LNG=103.6
GEO_MAX_LNG=104.2

# Queue Jobs
VALIDATE_IMAGE_TRIES=3
VALIDATE_IMAGE_TIMEOUT=30
NOTIFICATION_TRIES=3

# Optional services
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@nadikota.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
